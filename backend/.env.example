# App Configuration
APP_NAME=SecureShare
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32-chars

# Security & JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=secureshare
POSTGRES_PASSWORD=secureshare_secret
POSTGRES_DB=secureshare_db
DATABASE_URL=postgresql+asyncpg://secureshare:secureshare_secret@localhost:5432/secureshare_db

# Redis Cache & Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery & RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (AWS S3 or Local MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=secureshare-files
S3_REGION=us-east-1
S3_USE_SSL=False

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
